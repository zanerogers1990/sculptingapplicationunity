// Scatters position/normal/color for a small set of touched vertex indices directly into a
// mesh's own GPU vertex buffer, instead of Unity's managed Mesh.vertices/.normals/.colors
// setters - those always reupload the ENTIRE buffer regardless of how many vertices actually
// changed, which is the real per-frame ceiling SculptableMesh.ApplyVerticesLocal hits at high
// polycounts (see GpuVertexScatter.cs, the only caller). CPU stays fully authoritative for
// everything else (raycasting/undo/mask/mirror) - this kernel is a one-way write into the
// render-facing buffer, never read back.
#pragma kernel ScatterVertexAttributes

RWByteAddressBuffer _VertexBuffer;
// The dirty vertices, packed by GpuVertexScatter.DirtyVertex - 44 bytes each: uint index, then
// float3 position, float3 normal, float4 color. Read and written as raw bits by byte offset, so
// the layout means the same thing on every graphics API.
ByteAddressBuffer _DirtyVertices;

uint _Stride;
uint _PositionOffset;
uint _NormalOffset;
uint _ColorOffset;
// Window into _DirtyVertices this dispatch covers - see GpuVertexScatter.Upload.
uint _DirtyStart;
uint _DirtyCount;

[numthreads(64, 1, 1)]
void ScatterVertexAttributes(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DirtyCount) return;

    uint source = (_DirtyStart + id.x) * 44;
    uint baseAddress = _DirtyVertices.Load(source) * _Stride;
    _VertexBuffer.Store3(baseAddress + _PositionOffset, _DirtyVertices.Load3(source + 4));
    _VertexBuffer.Store3(baseAddress + _NormalOffset, _DirtyVertices.Load3(source + 16));
    _VertexBuffer.Store4(baseAddress + _ColorOffset, _DirtyVertices.Load4(source + 28));
}
